/* examples.mac -- GENERATED by tests/gen_examples.py from tests/cases.py (the cases of
   examples.py).  Do not edit; regenerate.

       maxima --very-quiet --batch=examples.mac            (from mixed/maxima)
       QUICK=1 ... skips the two slowest benchmarks (set quick:true below)

   Every case records the outcome the paper claims (an integral, a certificate or an
   honest 'failed'); every returned integral is checked once more by differentiating
   the surface expression numerically at three points, as examples.py does. */
if not member('pm_loaded, values) then load("pm_load.mac")$
quick: is(getenv("QUICK") = "1")$
results: []$
check_integral(I0, surface, subs, var) := block([Is, v, ok: true, fpprec: 30],
  Is: sublis(subs, I0),
  for pt in [3/2, 2, 7/3] do (
    v: errcatch(cabs(rectform(bfloat(subst(pt, var, diff(Is, var) - surface))))),
    if v = [] or not is(first(v) < 1b-20) then ok: false),
  ok)$
run(label, f, T, expect, [opts]) := block(
  [surface: assoc('surface, opts, false), subs: assoc('subs, opts, []),
   var: assoc('var, opts, x), verbose: assoc('verbose, opts, false),
   slow: assoc('slow, opts, false), t0, r, dt, ok],
  if slow and quick then (printf(true, "[~a] skipped (QUICK)~%", label), return(false)),
  printf(true, "~%### ~a~%", label),
  t0: elapsed_real_time(),
  r: parallel_integrate_mixed(f, T, ['verbose = verbose]),
  dt: elapsed_real_time() - t0,
  if expect = "integral" then (
    ok: not listp(r),
    if ok and surface # false then ok: check_integral(r, surface, subs, var),
    printf(true, "~a~%", pm_truncate(string(r), 300)))
  else (
    ok: listp(r) and stringp(first(r)) and pm_starts_with(first(r), expect),
    printf(true, "~a~%", string(r))),
  results: endcons([label, expect, ok, dt], results),
  printf(true, "--> ~a  (~,1fs)~%", if ok then "PASS" else "FAIL", dt))$
runS(label, f, [opts]) := block([expect: assoc('expect, opts, "integral"), t0, r, dt, ok, v, fpprec: 25],
  printf(true, "~%### ~a~%", label),
  t0: elapsed_real_time(),
  r: errcatch(integrate_surface(f, x)),
  r: if r = [] then ["error", "exception"] else first(r),
  dt: elapsed_real_time() - t0,
  if expect = "integral" then (
    ok: not listp(r),
    if ok then for pt in [1/3, 1/2] do (
      v: errcatch(cabs(rectform(bfloat(subst(pt, x, diff(r, x) - f))))),
      if v = [] or not is(first(v) < 1b-15) then ok: false),
    printf(true, "~a~%", pm_truncate(string(r), 300)))
  else (
    ok: listp(r) and stringp(first(r)) and pm_starts_with(first(r), expect),
    printf(true, "~a~%", string(r))),
  results: endcons([label, expect, ok, dt], results),
  printf(true, "--> ~a  (~,1fs)~%", if ok then "PASS" else "FAIL", dt))$
pm_truncate(s, n) := if slength(s) > n then sconcat(substring(s, 1, n + 1), " ...") else s$
pm_starts_with(s, p) := is(slength(s) >= slength(p) and substring(s, 1, slength(p) + 1) = p)$
/* the generator symbols are plain Maxima symbols; x is the integration variable */
/* ================================================================ tower form */
run("10.1 flagship: int log(x+sqrt(x^2+1))",
    [t, 0],
    tower([x, t], [[1, 0], [0, (x^2 + 1)^(-1)]], x^2 + 1, 2),
    "integral",
    'surface = log(x + sqrt(x^2 + 1)), 'subs = [t = log(x + sqrt(x^2 + 1))])$

run("10.2 irreplaceable unit (t = exp y)",
    [0, (t*x + 1)/(x^2 + 1)],
    tower([x, t], [[1, 0], [0, t*x/(x^2 + 1)]], x^2 + 1, 2),
    "integral",
    'surface = (x*exp(sqrt(x^2 + 1)) + 1)/sqrt(x^2 + 1), 'subs = [t = exp(sqrt(x^2 + 1))])$

run("10.3 moving prime: not elementary",
    [1/(t*x), 0],
    tower([x, t], [[1, 0], [0, (x^2 + 1)^(-1)]], x^2 + 1, 2),
    "not elementary",
    'verbose = true)$

run("10.4 Bronstein (E): not elementary",
    [t^2/(t^2 + 1), (t^2 + 1)^(-1)],
    tower([x, t], [[1, 0], [1/(2*t*x), 0]], t^2 + t, 2),
    "not elementary",
    'verbose = true)$

run("10.5 exp(sqrt x) (flattened)",
    [t, 0],
    tower([u, t], [[1/(2*u), 0], [t/(2*u), 0]], false, 1),
    "integral",
    'surface = exp(sqrt(x)), 'subs = [u = sqrt(x), t = exp(sqrt(x))])$

run("10.6 tan(sqrt x)/sqrt x (flattened)",
    [t/u, 0],
    tower([u, t], [[1/(2*u), 0], [(t^2 + 1)/(2*u), 0]], false, 1),
    "integral",
    'surface = tan(sqrt(x))/sqrt(x), 'subs = [u = sqrt(x), t = tan(sqrt(x))], 'verbose = true)$

run("10.7 tan over the curve (elementary instance)",
    [x*(t^2 + 1), 3*t*x/(x^2 + 1)],
    tower([x, t], [[1, 0], [0, (t^2*x + x)/(x^2 + 1)]], x^2 + 1, 2),
    "integral",
    'surface = x*(tan(sqrt(x^2 + 1))^2 + 1) + 3*x*tan(sqrt(x^2 + 1))/sqrt(x^2 + 1), 'subs = [t = tan(sqrt(x^2 + 1))])$

run("10.7 int tan(sqrt(x^2+1)) dx: not elementary (residue at v_oo)",
    [t, 0],
    tower([x, t], [[1, 0], [0, (t^2*x + x)/(x^2 + 1)]], x^2 + 1, 2),
    "not elementary",
    'verbose = true)$

run("10.8 curve-split moving logands",
    [(-5*x - 1)/(t^2 - x^2 - 1), (t^3 + t*(-x^2 + x + 4))/((x^2 + 1)*(t^2 - x^2 - 1))],
    tower([x, t], [[1, 0], [0, (x^2 + 1)^(-1)]], x^2 + 1, 2),
    "integral",
    'surface = (-(5*x + 1)*sqrt(x^2 + 1) + (-x^2 + x + 4)*log(x + sqrt(x^2 + 1)) + log(x + sqrt(x^2 + 1))^3)/(sqrt(x^2 + 1)*(-x^2 + log(x + sqrt(x^2 + 1))^2 - 1)), 'subs = [t = log(x + sqrt(x^2 + 1))], 'verbose = true)$

run("10.9 tutorial Ex 14 (flattened)",
    [(x + 1)/(u*x) + (2*u*x + x + 1)/(u*x*(u + x)), 0],
    tower([x, u], [[1, 0], [(x + 1)/(2*u*x), 0]], false, 1),
    "integral",
    'surface = (3*x^2 + x + sqrt(x + log(x))*(x^2 + 2*x + 1) + (3*x + 1)*log(x))/(x^3 + x^2*log(x) + sqrt(x + log(x))*(x^2 + x*log(x))), 'subs = [u = sqrt(x + log(x))])$

run("10.10 tutorial Ex 15 (flattened)",
    [(u^3*(2*x^2 + 3*x) + 3*u - 2*x^3 + 2*x^2)/(u*x), 0],
    tower([x, u], [[1, 0], [(u^3 - x + 1)/(3*u^2), 0]], false, 1),
    "integral",
    'surface = (5*x^2 + 3*(x + exp(x))^(1/3) + (2*x^2 + 3*x)*exp(x))/(x*(x + exp(x))^(1/3)), 'subs = [u = (x + exp(x))^(1/3)])$

run("10.11 JSC90 p.134: (x+1)/((x log x + x^2) sqrt(x+log x))",
    [(x + 1)/(u^3*x), 0],
    tower([x, u], [[1, 0], [(x + 1)/(2*u*x), 0]], false, 1),
    "integral",
    'surface = (x + 1)/(sqrt(x + log(x))*(x^2 + x*log(x))), 'subs = [u = sqrt(x + log(x))], 'verbose = true)$

run("10.11 JSC90 p.147 as printed (x^2+x+1): not elementary",
    [(3*u*x + u + x^2 + x + 1)/(u^2*x + u*x^2), 0],
    tower([x, u], [[1, 0], [(x + 1)/(2*u*x), 0]], false, 1),
    "not elementary",
    'verbose = true)$

run("10.11 JSC90 p.147 corrected, lowest terms: ((x+1)^2 + (3x+1)u)/(x u (u+x))",
    [(3*u*x + u + x^2 + 2*x + 1)/(u^2*x + u*x^2), 0],
    tower([x, u], [[1, 0], [(x + 1)/(2*u*x), 0]], false, 1),
    "integral",
    'surface = ((x + 1)^2 + sqrt(x + log(x))*(3*x + 1))/(x*(x + sqrt(x + log(x)))*sqrt(x + log(x))), 'subs = [u = sqrt(x + log(x))], 'verbose = true)$

run("10.12 Cohen 1993",
    [0, x/(x^4 + 10*x^2 - 96*x - 71)],
    tower([x], [[1, 0]], x^4 + 10*x^2 - 96*x - 71, 2),
    "integral",
    'surface = x/sqrt(x^4 + 10*x^2 - 96*x - 71), 'verbose = true)$

run("10.13 Schultz 2015 (genus 2)",
    [0, (29*x^2 + 18*x - 3)/(x^6 + 4*x^5 + 6*x^4 - 12*x^3 + 33*x^2 - 16*x)],
    tower([x], [[1, 0]], x^6 + 4*x^5 + 6*x^4 - 12*x^3 + 33*x^2 - 16*x, 2),
    "integral",
    'surface = (29*x^2 + 18*x - 3)/sqrt(x^6 + 4*x^5 + 6*x^4 - 12*x^3 + 33*x^2 - 16*x), 'verbose = true)$

run("10.14 Bronstein ISSAC'91",
    [t*(5*x^4 + 2*x - 2)/x^2, t*(5*x^4 + x^3 + 2*x - 2)/(x^2*(x^3 + 1))],
    tower([x, t], [[1, 0], [0, (5*t*x^3 + 2*t)/(2*x^3 + 2)]], x^3 + 1, 2),
    "integral",
    'surface = (x/sqrt(x^3 + 1) + (1 + 1/sqrt(x^3 + 1))*(5*x^4 + 2*x - 2)/x^2)*exp(x*sqrt(x^3 + 1)), 'subs = [t = exp(x*sqrt(x^3 + 1))], 'verbose = true)$

run("10.15 Chebyshev (Davenport Ex. 5)",
    [0, (2*x^6 + 4*x^5 + 7*x^4 - 3*x^3 - x^2 - 8*x - 8)/((2*x^2 - 1)^2*(x^4 + 4*x^3 + 2*x^2 + 1))],
    tower([x], [[1, 0]], x^4 + 4*x^3 + 2*x^2 + 1, 2),
    "integral",
    'surface = (2*x^6 + 4*x^5 + 7*x^4 - 3*x^3 - x^2 - 8*x - 8)/((2*x^2 - 1)^2*sqrt(x^4 + 4*x^3 + 2*x^2 + 1)), 'verbose = true, 'slow = true)$

run("10.16 Günther 1882 (order-6 torsion)",
    [0, x/((x^3 - 1)*(x^3 + 8))],
    tower([x], [[1, 0]], x^3 - 1, 2),
    "integral",
    'surface = x/(sqrt(x^3 - 1)*(x^3 + 8)), 'verbose = true, 'slow = true)$

run("9.2(b) certified: dx/((x-2) sqrt(x^3+1)) (holomorphic remainder)",
    [0, 1/((x - 2)*(x^3 + 1))],
    tower([x], [[1, 0]], x^3 + 1, 2),
    "not elementary",
    'verbose = true)$

run("10.12 Cohen's -72 variant: not elementary (non-torsion mod p + exact bounds)",
    [0, x/(x^4 + 10*x^2 - 96*x - 72)],
    tower([x], [[1, 0]], x^4 + 10*x^2 - 96*x - 72, 2),
    "not elementary",
    'verbose = true)$

run("10.17 sqrt(x + sqrt(1-x^2)) over the parametrised conic: not elementary (rescaled to d/dw, holomorphic remainder)",
    [0, (w^2 + 1)^(-1)],
    tower([w], [[(-w^4 - 2*w^2 - 1)/(2*w^2 - 2), 0]], -w^4 + 2*w^3 + 2*w + 1, 2),
    "not elementary",
    'verbose = true)$

run("regression (not in paper): torus over the logarithmic tower",
    [5/(2*t*x), (4*t^3 + 3*t + 1)/(2*t*x*(t^2 + 1))],
    tower([x, t], [[1, 0], [x^(-1), 0]], t^2 + 1, 2),
    "integral",
    'surface = (5*sqrt(log(x)^2 + 1) + 4*log(x)^3 + 3*log(x) + 1)/(2*x*sqrt(log(x)^2 + 1)*log(x)), 'subs = [t = log(x)], 'verbose = true)$

run("regression (extended K1): x^sqrt2 ((1 + sqrt2) log x + 1) on the log-exp tower t1 = log x, t2 = x^sqrt2",
    [t2*(t1*(1 + sqrt(2)) + 1), 0],
    tower([x, t1, t2], [[1, 0], [x^(-1), 0], [sqrt(2)*t2/x, 0]], false, 1),
    "integral",
    'surface = x^(sqrt(2))*((1 + sqrt(2))*log(x) + 1), 'subs = [t1 = log(x), t2 = x^(sqrt(2))], 'verbose = true)$

run("regression (non-torsion residue divisor at finite places): u^17 y/((u^4-1)(u^10+1)^2) on y^2 = u^10 + 1, Du = 1/(2u)",
    [0, u^17/((u^4 - 1)*(u^10 + 1)^2)],
    tower([u], [[1/(2*u), 0]], u^10 + 1, 2),
    "not elementary",
    'verbose = true)$

run("pmint G1: log(log(x)^3 + x^3 + 1)",
    [(3*t^2/x + 3*x^2)/(t^3 + x^3 + 1), 0],
    tower([x, t], [[1, 0], [x^(-1), 0]], false, 1),
    "integral",
    'surface = (3*x^2 + 3*log(x)^2/x)/(x^3 + log(x)^3 + 1), 'subs = [t = log(x)], 'verbose = true)$

run("pmint G1c: 1/(log(x)^3 + x^3 + 1) not elementary",
    [(t^3 + x^3 + 1)^(-1), 0],
    tower([x, t], [[1, 0], [x^(-1), 0]], false, 1),
    "not elementary",
    'verbose = true)$

run("pmint G2: log-exp showcase (deep pole, non-constant place)",
    [(ee^2*x + ee*el*x + ee*x^2 + ee + el*x + el + x^2 - 1)/(ee^2*x + 2*ee*el*x + 2*ee*x^2 + el^2*x + 2*el*x^2 + x^3), 0],
    tower([x, el, ee], [[1, 0], [x^(-1), 0], [ee, 0]], false, 1),
    "integral",
    'surface = (x*exp(x) + x + 1)*(x + exp(x) + log(x) - 1)/(x*(x + exp(x) + log(x))^2), 'subs = [el = log(x), ee = exp(x)], 'verbose = true)$

run("pmint G3: LambertW(x^2) rational (deep pole, delta = 2)",
    [(Wg^2*(x^2 + 2) + x^2*(2*Wg + 1))/(x*(Wg + 1)^3), 0],
    tower([x, Wg], [[1, 0], [2*Wg/(Wg*x + x), 0]], false, 1),
    "integral",
    'surface = (x^2*(2*lambert_w(x^2) + 1) + (x^2 + 2)*lambert_w(x^2)^2)/(x*(lambert_w(x^2) + 1)^3), 'subs = [Wg = lambert_w(x^2)], 'verbose = true)$

run("R1 rational 1/(x^4-1): residues -+i/4 over x^2+1",
    [(x^4 - 1)^(-1), 0],
    tower([x], [[1, 0]], false, 1),
    "integral",
    'surface = (x^4 - 1)^(-1))$

run("R2 rational x/(x^3-2): three distinct residues over a cubic prime",
    [x/(x^3 - 2), 0],
    tower([x], [[1, 0]], false, 1),
    "integral",
    'surface = x/(x^3 - 2))$

run("R3 1/(x (log(x)^2+1)): unequal residues over t^2+1 in the log variable",
    [1/(x*(t^2 + 1)), 0],
    tower([x, t], [[1, 0], [x^(-1), 0]], false, 1),
    "integral",
    'surface = 1/(x*(log(x)^2 + 1)), 'subs = [t = log(x)])$

run("R4 D[log(x)/(1+x^2) + arctan x] on {x, log x}: double pole at x^2+1, residues -+i/2 in kappa(P)",
    [(-2*t*x^2 + x^3 + x^2 + x + 1)/(x^5 + 2*x^3 + x), 0],
    tower([x, t], [[1, 0], [x^(-1), 0]], false, 1),
    "integral",
    'surface = -2*x*log(x)/(x^2 + 1)^2 + (x^2 + 1)^(-1) + 1/(x*(x^2 + 1)), 'subs = [t = log(x)])$

run("R5 log(x+sqrt(x^2-1))/x^2 on the parametrised conic w = y/(x-1): residues -+i at w^2+1 from a double pole",
    [(t1*w_x^4 - 2*t1*w_x^2 + t1)/(w_x^4 + 2*w_x^2 + 1), 0],
    tower([w_x, t1], [[(-w_x^4 + 2*w_x^2 - 1)/(4*w_x), 0], [(w_x^2 - 1)/(2*w_x), 0]], false, 1),
    "integral",
    'surface = log(x + sqrt(x^2 - 1))/x^2, 'subs = [w_x = sqrt(x^2 - 1)/(x - 1), t1 = log(Y + x), Y = sqrt(x^2 - 1)])$

/* ================================================================ surface forms */
runS("S1  log(x + sqrt(x^2+1))", log(x + sqrt(x^2 + 1)))$
runS("S2  exp(sqrt x)", exp(sqrt(x)))$
runS("S3  tan(sqrt x)/sqrt x", tan(sqrt(x))/sqrt(x))$
runS("S4  arctan(x)/sqrt x  (ArcTan primitive, split specials)", atan(x)/sqrt(x))$
runS("S5  arctan(sqrt x)", atan(sqrt(x)))$
runS("S6  arcsin(x)  (radical introduced by the derivative)", asin(x))$
runS("S7  log(x) arcsin(x)  (S'-unit over the special x)", log(x)*asin(x))$
runS("S8  arcsin(sqrt(x+1) - sqrt x)  (Euler parametrisation of the conic)", -asin(sqrt(x) - sqrt(x + 1)))$
runS("S9  cos^2 x / sqrt(cos^4 x + cos^2 x + 1)  (t = tan x, cubic model, Miller S'-units)", cos(x)^2/sqrt(cos(x)^4 + cos(x)^2 + 1))$
runS("S10 tan(x)/sqrt(1 + sec^3 x)  (odd in sin: u = cos x)", tan(x)/sqrt(sec(x)^3 + 1))$
runS("S11 tan(x) sqrt(1 + tan^4 x)  (radical over the tangent)", sqrt(tan(x)^4 + 1)*tan(x))$
runS("S12 sqrt(tan x)  (specials split over Fbar)", sqrt(tan(x)))$
runS("S13 sqrt(log x): not elementary, honest 'failed'", sqrt(log(x)), 'expect = "failed")$
runS("S14 exp(x^2): not elementary  (K4 at x = oo: the hyperexponential shift is exact, bound proved, no solution)", exp(x^2), 'expect = "not elementary")$
runS("S15 Bronstein (E) nested radical: not elementary", (sqrt(sqrt(log(x)) + log(x)) + log(x))/(log(x) + 1), 'expect = "not elementary")$
runS("S16 sqrt(sin x)/(1 + sin^2 x)  (Charlwood A27: residues at the degree-8 prime in the residue field)", sqrt(sin(x))/(sin(x)^2 + 1))$
runS("S17 sqrt(1 + sec x tan x)  (cubic model: the residue divisor is 2-torsion, its places are not)", sqrt(tan(x)*sec(x) + 1))$
runS("S18 sqrt(x + sqrt(1 - x^2)): not elementary  (nested radical over the conic: (R4), rescaled to d/dw, holomorphic remainder)", sqrt(x + sqrt(1 - x^2)), 'expect = "not elementary")$
runS("S19 sqrt(x) arcsin(sqrt(x+1))  (Euler parameter w = sqrt x + sqrt(x+1), no radical; real nowhere, the sign convention of x > 0)", sqrt(x)*asin(sqrt(x + 1)))$
runS("S20 arcsin(sqrt(x+1))/sqrt x", asin(sqrt(x + 1))/sqrt(x))$
runS("S21 coth(x)/(1+sech(x)^5)^(3/2): not elementary  (odd in sinh: u = cosh x, flattened root, genus 4; the residue divisor over u = +-1 is certified non-torsion by reduction mod 17, 41)", coth(x)/(sech(x)^5 + 1)^(3/2), 'expect = "not elementary")$
runS("S22 sinh(x)^3  (odd in sinh: u = cosh x, sinh^2 = cosh^2 - 1)", sinh(x)^3)$
runS("S23 coth(x) sqrt(cosh x)  (odd in sinh with 1/sinh; flattened root)", sqrt(cosh(x))*coth(x))$
runS("M1  1/(x^3-1)^(1/3)  (Fermat cubic: units at the three places at infinity)", (x^3 - 1)^(-1/3))$
runS("M2  1/(x (x^3+1)^(1/3))  (residue classes over x, 3-torsion, logands y - zeta)", 1/(x*(x^3 + 1)^(1/3)))$
runS("M3  1/(x (x^2-1)^(1/3))  (one place at infinity, 2-torsion classes)", 1/(x*(x^2 - 1)^(1/3)))$
runS("M4  x^2 log(x)/(x^3+1)^(2/3) + (x^3+1)^(1/3)/x  (log above the cube root)", x^2*log(x)/(x^3 + 1)^(2/3) + (x^3 + 1)^(1/3)/x)$
runS("M5  1/(x (x^4+1)^(1/4))  (m = 4, residue classes over Q(i))", 1/(x*(x^4 + 1)^(1/4)))$
runS("M6  1/(x^4+1)^(1/4)  (m = 4, units at the four places at infinity)", (x^4 + 1)^(-1/4))$
runS("M7  x/(x^3-1)^(1/3): not elementary  (three places at infinity: exact valuations there, zero residues everywhere, holomorphic remainder)", x/(x^3 - 1)^(1/3), 'expect = "not elementary")$
runS("N1  (x^2-1) sqrt(x^4-x^2+1)/((x^2+1)(x^4+1))  (norm search at k = 2 and k = 1)", (x^2 - 1)*sqrt(x^4 - x^2 + 1)/((x^2 + 1)*(x^4 + 1)))$
runS("T1  1/(x sqrt(1-x^3))  (order-3 torsion, tutorial Example 6)", 1/(x*sqrt(1 - x^3)))$
runS("S21w sin(x)/(1+cos(x))  (half-angle)", sin(x)/(cos(x) + 1))$
runS("S22w sinh(x)^2  (even hyperbolic)", sinh(x)^2)$
runS("S30a asec(x)", asec(x))$
runS("S30b acsc(x)", acsc(x))$
runS("S30c acot(x)", acot(x))$
runS("S30d acoth(x)", acoth(x))$
runS("S30e asech(x)", asech(x))$
runS("S30f acsch(x)", acsch(x))$
runS("S30g x^x (1 + log x)", x^x*(log(x) + 1))$

/* ================================================================ summary */
printf(true, "~%~a~%", smake(78, "="))$
block([w: lmax(map(lambda([r], slength(first(r))), results))],
  for r in results do printf(true, "~a~a  ~a~a ~a  ~6,1fs~%", r[1], smake(w - slength(r[1]), " "),
                              r[2], smake(max(0, 15 - slength(r[2])), " "), if r[3] then "PASS" else "FAIL", r[4]))$
printf(true, "~a~%", smake(78, "="))$
nfail: length(sublist(results, lambda([r], not r[3])))$
printf(true, "~a/~a passed~%", length(results) - nfail, length(results))$
if nfail > 0 then quit(1) else quit(0)$
